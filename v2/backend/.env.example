# =============================================================
#  API do Portifólio — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env.
#  Gere segredos com: openssl rand -hex 32
# =============================================================

APP_NAME=portifolio-api
APP_ENV=local                  # local | staging | production
APP_DEBUG=true                 # sempre false em produção
APP_URL=http://127.0.0.1:8000
APP_VERSION=2.0.0
APP_KEY=                       # openssl rand -hex 32
APP_FORCE_HTTPS=false          # true em produção
APP_SECURE_COOKIES=false       # true em produção (exige HTTPS)

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=               # IPs de proxy confiáveis, separados por vírgula

# ---- Banco de dados ----
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portifolio
DB_USER=root
DB_PASS=

# ---- Autenticação ----
JWT_SECRET=                    # openssl rand -hex 32 (mínimo 32 caracteres)
JWT_ACCESS_TTL=900             # segundos (15 min)
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TTL=60      # minutos
PASSWORD_RESET_TTL=30          # minutos

# ---- Hashing ----
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=2
BCRYPT_COST=12

# ---- Rate limit ----
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60

# ---- E-mail ----
MAIL_DRIVER=log                # log grava em storage/logs em vez de enviar (use em dev)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=                 # senha de aplicativo, nunca a senha da conta
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Portifólio

# ---- Documentos legais ----
# Devem bater com src/lib/legal.ts no frontend. Ao alterar um documento de forma
# relevante, incremente a versão nos DOIS lugares — é ela que fica gravada no
# registro de consentimento do usuário.
TERMS_VERSION=1.0.0
PRIVACY_VERSION=1.0.0

# ---- Observabilidade ----
LOG_PATH=php://stdout
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=portifolio-api
