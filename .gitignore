# ==========================================================
#  Portifolio — ignores da raiz
#  Regras específicas de cada versão ficam em v1/ e v2/
# ==========================================================

# Segredos — nunca versionar
.env
.env.local
.env.*.local

# Ajustes de ambiente que valem só na máquina de quem desenvolve.
# O Compose mescla este arquivo automaticamente; versioná-lo imporia a
# configuração de uma máquina a todo mundo.
docker-compose.override.yml

# Dependências
/v1/vendor/
/v2/backend/vendor/
/v2/frontend/node_modules/

# Build
/v2/frontend/.next/
/v2/frontend/.next-prod/
/v2/frontend/out/
/v2/frontend/next-env.d.ts
# Cache incremental do tsc, gerado por `npm run typecheck`.
/v2/frontend/tsconfig.tsbuildinfo

# Testes e cobertura
/v2/backend/coverage.xml
/v2/backend/coverage-html/
/v2/backend/.phpunit.cache/
/v2/frontend/coverage/
/v2/frontend/playwright-report/
/v2/frontend/test-results/

# Fotos enviadas pelo painel: conteúdo, não código.
#
# Versionar as imagens faria cada envio virar commit e o repositório crescer
# para sempre. Em troca, elas só existem no servidor onde foram enviadas — e é
# por isso que a pasta de uploads precisa entrar no backup e NUNCA ser
# sobrescrita pelo pacote de deploy. O .htaccess, que é o que protege a pasta,
# fica versionado de propósito.
/v2/backend/public/uploads/**
!/v2/backend/public/uploads/.htaccess
!/v2/backend/public/uploads/projetos/
/v2/backend/public/uploads/projetos/*
!/v2/backend/public/uploads/projetos/.gitkeep

# Logs e cache
/v2/backend/storage/logs/*
!/v2/backend/storage/logs/.gitkeep
*.log
.phpstan.cache/
.php-cs-fixer.cache

# Editor / SO
.idea/
.vscode/
.DS_Store
Thumbs.db

# Permissões que o Claude Code grava por máquina. O .claude/CLAUDE.md, esse
# sim, é versionado: vale para quem clonar o repositório.
.claude/settings.local.json
