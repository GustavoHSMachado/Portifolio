# Variáveis do docker-compose. Copie para .env — ou rode `make secrets`.
# NUNCA versione o .env.

# Gere com: openssl rand -hex 32
APP_KEY=
JWT_SECRET=

DB_ROOT_PASSWORD=root
DB_NAME=portifolio
DB_USER=portifolio
DB_PASSWORD=portifolio

# ----------------------------------------------------------------------
#  Portas publicadas no host
#
#  Só a porta do host muda; dentro da rede do compose os serviços continuam
#  se falando pelas portas internas de sempre. Se outra stack já ocupa uma
#  delas, o erro é `port is already allocated` — troque o valor aqui.
#  Confira o que está em uso com: docker ps --format "{{.Names}} {{.Ports}}"
# ----------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
ADMINER_PORT=8080
# 3307 evita conflito com um MySQL já instalado na máquina.
DB_PORT=3307
