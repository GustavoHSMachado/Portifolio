{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "next": { "entry": ["src/app/**/{page,layout,route,template,error,not-found,loading}.tsx"] },
  "entry": ["src/app/**/*.tsx", "playwright.config.ts", "vitest.config.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/**/*.d.ts"],
  "ignoreDependencies": ["@stryker-mutator/vitest-runner", "husky"],
  "ignoreExportsUsedInFile": true
}
