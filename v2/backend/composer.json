{
    "name": "gustavohsmachado/portifolio-api",
    "description": "API REST do portfólio — PHP 8.3, MVC próprio, PSR-4.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "firebase/php-jwt": "^6.10",
        "monolog/monolog": "^3.6",
        "open-telemetry/api": "^1.1",
        "phpmailer/phpmailer": "^6.9",
        "sentry/sentry": "^4.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.58",
        "infection/infection": "^0.29",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.2",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-clover=coverage.xml",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=512M",
        "mutation": "infection --min-msi=70 --threads=4",
        "migrate": "php database/migrate.php",
        "serve": "php -S 127.0.0.1:8000 -t public"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
